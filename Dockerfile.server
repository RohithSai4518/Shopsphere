# Multi-Stage Dockerfile for ShopSphere Node.js Backend Server
FROM node:20-alpine AS build

WORKDIR /app
COPY server/package*.json ./
RUN npm ci --only=production

COPY server/ ./

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

COPY --from=build /app ./

EXPOSE 5000
CMD ["node", "src/app.js"]
