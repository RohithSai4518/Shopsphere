# ShopSphere Python Marketplace Environment Configuration Example
# Copy this file to .env for local development.

DJANGO_SECRET_KEY=synthetic_shopsphere_django_secret_key_change_me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=data/shopsphere_django.sqlite3
SITE_NAME=ShopSphere Marketplace
COMMISSION_DEFAULT_RATE=8.50
CURRENCY_CODE=USD
STATIC_URL=/static/
MEDIA_URL=/media/
